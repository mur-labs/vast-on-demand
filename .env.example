# Required: Vast.ai API key (https://cloud.vast.ai/account/)
VAST_API_KEY=your_vast_api_key_here

# Optional: Hugging Face token for gated models
# HF_TOKEN=hf_...

# Optional: Override default GGUF model and context size
# MODEL_URL=https://huggingface.co/bartowski/Qwen2.5-14B-Instruct-GGUF/resolve/main/Qwen2.5-14B-Instruct-Q4_K_M.gguf
# CTX_SIZE=32768

# Optional: Custom container image (defaults to ghcr.io/mur-labs/vast-on-demand:latest in CLI)
# RENTAL_DOCKER_IMAGE=ghcr.io/mur-labs/vast-on-demand:latest
# CONTAINER_PORT=8080

# Optional: Rental behavior
# VAST_SPOT_INSTANCES=true
# VAST_BID_BUFFER=0.20
# VAST_IDLE_ACTION=destroy
